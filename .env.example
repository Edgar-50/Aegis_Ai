# AegisAI 1.0 — copy to .env and replace every production secret.
AEGIS_ENV=development
POSTGRES_PASSWORD=aegis_dev
JWT_SECRET=replace-with-a-long-random-secret
AEGIS_ADMIN_USER=admin
AEGIS_ADMIN_PASSWORD=replace-admin-password
AEGIS_ANALYST_USER=analyst
AEGIS_ANALYST_PASSWORD=replace-analyst-password
ACCESS_TOKEN_MINUTES=480
THREAT_SCORE_ALERT_THRESHOLD=70

# Evidence object storage (Docker ships MinIO locally)
EVIDENCE_BACKEND=s3
MINIO_ROOT_USER=aegisadmin
MINIO_ROOT_PASSWORD=replace-minio-password
S3_BUCKET=aegis-evidence

# OIDC / SSO (optional, real verification when configured)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# MISP threat intelligence (optional)
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true

# TAXII 2.1 threat intelligence (optional)
TAXII_COLLECTION_URL=
TAXII_USERNAME=
TAXII_PASSWORD=

# Real SOAR provider. No simulated success: disabled means actions fail closed.
# Supported: disabled | cloudflare | crowdstrike | msgraph
SOAR_PROVIDER=disabled

# Cloudflare firewall source-IP blocking
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# CrowdStrike endpoint containment
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# Microsoft Graph identity session revocation
MSGRAPH_ACCESS_TOKEN=

PROMETHEUS_ENABLED=true

# Investigation graph
NEO4J_PASSWORD=replace-neo4j-password
NEO4J_ENABLED=true

# Durable Kafka raw-event ingest
KAFKA_RAW_TOPIC=aegis.raw.events
KAFKA_CONSUMER_GROUP=aegis-detection-v1

# Distributed tracing
OTEL_ENABLED=true
